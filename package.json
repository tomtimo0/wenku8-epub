{
  "name": "book2epub",
  "version": "2.0.0",
  "description": "Convert supported light-novel sites to EPUB (multi-site adapter architecture)",
  "type": "module",
  "bin": {
    "book2epub": "./dist/cli.js",
    "wenku8-epub": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/copy-css.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "commander": "^13.1.0",
    "jszip": "^3.10.1",
    "playwright": "^1.51.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
